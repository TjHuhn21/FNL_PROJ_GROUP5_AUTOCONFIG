# NetCommand BACKEND settings - placeholders only. Copy to backend/.env (git-ignored)
# and fill in real values there. Never commit backend/.env.
#
# Only names starting with BACKEND_ are read. The desktop application's .env
# (DB_HOST, DB_PASSWORD, FERNET_KEY, ...) is never used by the backend.
# Another file can be used by setting NETCOMMAND_BACKEND_ENV_FILE to its path.

# ---- server (safe development defaults; not secrets)
BACKEND_ENV=development            # development | test | production
BACKEND_HOST=127.0.0.1             # this computer only (the default). Any other address
                                   # needs BACKEND_LAN_MODE=true and HTTPS (below)
BACKEND_PORT=8000                  # 8443 for LAN mode
BACKEND_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---- HTTPS and LAN mode (docs/LAN_DEPLOYMENT.md). Off by default: local development
# stays plain HTTP on 127.0.0.1. Make the certificate with
#   python -m backend.tls_cert --name netcommand-server
# The KEY file is secret: it stays on the server laptop and is never committed or copied.
# For LAN mode use: BACKEND_HOST=0.0.0.0, BACKEND_PORT=8443, BACKEND_LAN_MODE=true and
# both files below.
BACKEND_LAN_MODE=false
BACKEND_TLS_CERT_FILE=
BACKEND_TLS_KEY_FILE=

# ---- database: the backend's own database (accounts, sessions, audit log).
# Set BACKEND_DB_ENABLED=true for sign-in to work; the settings are checked only when enabled.
# Usual values: BACKEND_DB_NAME=netcommand_test, BACKEND_DB_USER=netcommand_api (the
# runtime account). Put the password in single quotes: BACKEND_DB_PASSWORD='...'
BACKEND_DB_ENABLED=false
BACKEND_DB_HOST=127.0.0.1
BACKEND_DB_PORT=3307
BACKEND_DB_USER=change-me
BACKEND_DB_PASSWORD=change-me
BACKEND_DB_NAME=change-me
# Optional; REQUIRED for the production database (netcommand_backend, which also needs
# BACKEND_ENV=production). The DBA reads it once with:  SELECT @@server_uuid;
# The tools then refuse to work if the server they reach reports another UUID: a
# safeguard against the wrong server/port/tunnel, not proof of identity.
BACKEND_DB_SERVER_UUID=

# ---- migration account (python -m backend.database.migrate only; never the web app)
# Usually netcommand_migrator; it must differ from BACKEND_DB_USER. Least privilege:
# TABLE-level grants on the backend tables only (CREATE/DROP/SELECT..., no DROP on
# audit_log, no TRIGGER) plus LOCK TABLES - the exact statements are printed by
#   .\venv\Scripts\python.exe -m backend.database.migrate recommended-grants
# Leave the password empty: the command then asks for it (it is never stored here).
BACKEND_MIGRATE_USER=change-me
BACKEND_MIGRATE_PASSWORD=

# ---- email delivery of the six-digit codes
# none (default: no email) | outbox (development only: .eml files; refused when
# BACKEND_ENV=production) | smtp (the BACKEND_SMTP_* settings below)
BACKEND_MAIL_BACKEND=none
# outbox folder; empty = netcommand-dev-outbox in the system temp folder. Must be
# outside the project folder.
BACKEND_MAIL_OUTBOX_DIR=

# ---- Gmail SMTP with STARTTLS (used when BACKEND_MAIL_BACKEND=smtp; checked only when enabled)
# Port 587 = STARTTLS (required), 465 = TLS from the start. Gmail needs an app password.
BACKEND_SMTP_ENABLED=false
BACKEND_SMTP_HOST=smtp.gmail.com
BACKEND_SMTP_PORT=587
BACKEND_SMTP_USERNAME=change-me@example.com
BACKEND_SMTP_PASSWORD=change-me
BACKEND_SMTP_FROM=change-me@example.com

# ---- secrets (checked when set)
# BACKEND_FERNET_KEY: not used by the backend yet - leave it empty. (security.py --new-key
# is for the DESKTOP's .env only: it writes FERNET_KEY there and never prints a key.)
BACKEND_FERNET_KEY=
# BACKEND_OTP_PEPPER: REQUIRED for sign-in. A random secret of at least 32 characters that
# protects the email codes. Generate one (it is shown once; copy it here in single quotes,
# then clear the screen):
#   .\venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_OTP_PEPPER=

# ---- authentication policy (optional; empty = the approved default)
# Values can only be made STRICTER than the defaults (see backend/auth/policy.py).
BACKEND_AUTH_PASSWORD_MIN_LENGTH=        # default 12   (12 .. 64)
BACKEND_AUTH_LOCKOUT_THRESHOLD=          # default 5    (3 .. 5 failed passwords)
BACKEND_AUTH_LOCKOUT_SECONDS=            # default 900  (900 .. 86400)
BACKEND_AUTH_OTP_TTL_SECONDS=            # default 300  (60 .. 300)
BACKEND_AUTH_OTP_MAX_ATTEMPTS=           # default 5    (1 .. 5)
BACKEND_AUTH_RESEND_COOLDOWN_SECONDS=    # default 60   (60 .. 900)
BACKEND_AUTH_SESSION_LIFETIME_SECONDS=   # default 28800 (900 .. 28800)
BACKEND_AUTH_IDLE_TIMEOUT_SECONDS=       # default 1800 (300 .. 1800, <= lifetime)
