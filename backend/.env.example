# NetCommand BACKEND settings - placeholders only. Copy to backend/.env (git-ignored)
# and fill in real values there. Never commit backend/.env.
#
# Only names starting with BACKEND_ are read. The desktop application's .env
# (DB_HOST, DB_PASSWORD, FERNET_KEY, ...) is never used by the backend.
# Another file can be used by setting NETCOMMAND_BACKEND_ENV_FILE to its path.

# ---- server (safe development defaults; not secrets)
BACKEND_ENV=development            # development | test | production
BACKEND_HOST=127.0.0.1             # Phase 4B: plain HTTP, keep it on 127.0.0.1
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---- database (not used yet; checked only when enabled)
BACKEND_DB_ENABLED=false
BACKEND_DB_HOST=127.0.0.1
BACKEND_DB_PORT=3307
BACKEND_DB_USER=change-me
BACKEND_DB_PASSWORD=change-me
BACKEND_DB_NAME=change-me

# ---- Gmail SMTP with STARTTLS (not used yet; checked only when enabled)
BACKEND_SMTP_ENABLED=false
BACKEND_SMTP_HOST=smtp.gmail.com
BACKEND_SMTP_PORT=587
BACKEND_SMTP_USERNAME=change-me@example.com
BACKEND_SMTP_PASSWORD=change-me
BACKEND_SMTP_FROM=change-me@example.com

# ---- secrets for later phases (leave empty until needed; checked when set)
# BACKEND_FERNET_KEY must be a Fernet key (python security.py --new-key prints the format)
BACKEND_FERNET_KEY=
# BACKEND_OTP_PEPPER: a long random value, at least 32 characters
BACKEND_OTP_PEPPER=
