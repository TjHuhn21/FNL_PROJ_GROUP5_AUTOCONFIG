DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=netcommand_app
DB_PASSWORD=replace-with-your-password
DB_NAME=netcommand
# 44 characters ending in "=". Do not type or paste it: run  python security.py --new-key
FERNET_KEY=generate-your-own
# Where the desktop signs in (the NetCommand backend; not a secret). Default:
# http://127.0.0.1:8000. A server on another computer must use https:// with its NAME,
# for example https://netcommand-server:8443 (docs/LAN_DEPLOYMENT.md).
NETCOMMAND_API_URL=http://127.0.0.1:8000
# https:// only (then required): the server's certificate (server.crt, PUBLIC; never the
# .key file). Only this certificate is trusted. A relative path is relative to this folder.
NETCOMMAND_API_CA_FILE=
# https:// only, optional: the server laptop's current IP address (the phone hotspot can
# change it). The certificate is still checked against the name in NETCOMMAND_API_URL.
NETCOMMAND_API_ADDRESS=
# Older Cisco IOS devices that only offer SHA-1 SSH key exchange / ssh-rsa host keys (not a
# secret). IPv4 addresses, separated by commas; every other device keeps strict SSH. Leave
# empty unless a device needs it. Example: NETCOMMAND_LEGACY_SSH_HOSTS=192.168.10.1
NETCOMMAND_LEGACY_SSH_HOSTS=
