
# Environment variables and secrets
.env
.env.*
!.env.example

# HTTPS certificate and PRIVATE KEY for LAN mode (python -m backend.tls_cert). The key
# must never leave the server laptop; certificates are copied to clients by hand.
backend/tls/
*.key
*.pem

# Python virtual environments
venv/
.venv/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Test and coverage files
.pytest_cache/
.coverage
htmlcov/

# IDE and editor files
.idea/

# Local backups and database files
backups/
*.sqlite
*.sqlite3
*.db

# Device configuration backups, database dumps and generated SQL (never commit:
# they can contain password hashes, account data or device configurations).
# schema.sql and docs/phase0/*.sql are source files and stay tracked.
*.bak
*.dump
*dump*.sql
*_backup.sql
*-backup.sql
backup_*.sql
audit_triggers.sql
audit_purge*.sql

# Logs (PuTTY / switch session logs, backend logs) and development email outbox files
*.log
*.eml

# Group documents kept outside the code repository (they contain members' names)
GROUP-5-PROPOSAL (2).docx

# Operating system files
.DS_Store
Thumbs.db

# Backup encryption recovery files (backup_keys.py): keep them OFFLINE, never in Git
*.ncrecovery

# Local project review documents
/document review/
